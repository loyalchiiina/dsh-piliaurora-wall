{
  "name": "dsh-piliaurora-wall",
  "version": "0.2.6",
  "description": "在 DSH 右侧边栏以面板页签形式提供 B 站视频墙：输入关键词即可并行打开多个独立播放窗口并自动网格排列，支持一键开关声音、全部隐藏/显示、切换下一批与自动连播。全程指令通道驱动，不抢鼠标、不截屏。内置依赖自检与设置页，可手动指定 PiliAurora 程序/服务脚本/Python 路径。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "locale/*.json",
    "screenshots",
    "screenshots.json"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "piliaurora",
    "bilibili",
    "video-wall",
    "multi-window",
    "grid"
  ],
  "license": "MIT",
  "author": "loyalchiiina",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loyalchiiina/dsh-piliaurora-wall.git"
  },
  "homepage": "https://github.com/loyalchiiina/dsh-piliaurora-wall#readme",
  "bugs": {
    "url": "https://github.com/loyalchiiina/dsh-piliaurora-wall/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  }
}